import { Palette } from "../theme/colors.slint";
import { Type } from "../theme/typography.slint";
import { Space } from "../theme/spacing.slint";
import { LinkCard } from "../components/link-card.slint";

export component HomeView inherits Rectangle {
    callback open-design-system;

    VerticalLayout {
        alignment: center;
        spacing: Space.xxl;

        VerticalLayout {
            spacing: Space.md;

            Image {
                source: @image-url("../assets/logo.png");
                height: 140px;
            }

            Text {
                text: "Libee";
                color: Palette.text;
                font-size: 34px;
                font-weight: Type.bold;
                horizontal-alignment: center;
            }

            Text {
                text: "See, understand and clean up the dev tools living on your machine.";
                color: Palette.text-muted;
                font-size: Type.heading;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: center;

            LinkCard {
                width: 440px;
                title: "Design system";
                description: "Colors, typography and components";
                icon: @image-url("../assets/icons/palette.svg");
                clicked => { root.open-design-system(); }
            }
        }
    }
}
