import "../assets/fonts/Inter.ttf";
import "../assets/fonts/JetBrainsMono.ttf";

export global Type {
    out property <string> sans: "Inter";
    out property <string> mono: "JetBrains Mono";

    out property <length> display: 28px;
    out property <length> title: 20px;
    out property <length> heading: 15px;
    out property <length> body: 13px;
    out property <length> caption: 11px;

    out property <int> regular: 400;
    out property <int> medium: 500;
    out property <int> semibold: 600;
    out property <int> bold: 700;
}
